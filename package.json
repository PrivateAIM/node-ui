{
  "name": "node-ui",
  "private": true,
  "version": "0.6.3",
  "license": "Apache-2.0",
  "description": "User interface for the FLAME Node software.",
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "scripts": {
    "start": "nuxt start",
    "build": "nuxt build",
    "coverage": "vitest run --coverage",
    "dev": "nuxt dev",
