    "test": "vitest",
    "test:ci": "CI=true pnpm --reporter-hide-prefix --stream --sequential run test"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.11.3",
    "@primeuix/themes": "^1.2.5",
    "@primevue/core": "^4.4.1",
