    "@primevue/forms": "^4.4.1",
    "@primevue/nuxt-module": "^4.4.1",
    "@sidebase/nuxt-auth": "1.1.0",
    "@types/uuid": "^9.0.8",
    "@vueuse/core": "^11.3.0",
    "chart.js": "^4.5.1",
    "globals": "^15.15.0",
    "next-auth": "~4.21.1",
    "nuxt": "^3.19.3",
    "pinia": "^2.3.1",
    "prettier": "^3.6.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "proxy-agent": "^5.0.0",
    "sass": "^1.93.2",
    "sass-loader": "^14.2.1",
    "swagger-typescript-api": "^13.2.16",
    "tailwindcss": "^3.4.18",
    "tailwindcss-primeui": "^0.4.0",
    "typescript": "^5.9.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "webpack": "^5.102.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/eslint-config-prettier": "^6.11.3",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "~9.26.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.0.8",
    "msw": "^2.11.6",
    "typescript-eslint": "^8.46.2",
    "vite-tsconfig-paths": "^5.1.4",
